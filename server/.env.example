# Copy to server/.env and fill in. Never commit the real .env.
# Supabase: Connect -> Session pooler. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
# Optional: enables Gemini document extraction and AI answers. Without it, uploads fall back to manual entry.
GEMINI_API_KEY=
# Optional: pin a Gemini model instead of auto-selecting a Flash model.
GEMINI_MODEL=
# Optional: how often the journey expiry sweep runs, in ms (default 60000, minimum 10000, 0 turns it off).
JOURNEY_SWEEP_INTERVAL_MS=60000
